PORT=9090
SERVER=127.0.0.1
PORT_SQL=3306
DATABASE=db_truck_manager
USERDB=truckmanager
PASSWORD=
DATABASE_TYPE=mysql
SECRETPRIVATEKEY=
# Panel del superadministrador (009): llave AES-256 del secreto del segundo
# factor, 32 bytes en hex. Generarla con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Cambiarla deja inservibles los secretos guardados (restablecer-2fa a todos).
PANEL_TOTP_KEY=
# PANEL_LOGIN_WINDOW_MIN=15               # ventana del límite de intentos del login del panel (cuántos: constantes panel.intentos_*)
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
SQL_LOG=false

# Dispositivo checador (análisis 005)
# FRONT_VERSION=0.5.0                     # versión del Front publicada; el checador se recarga solo si cambia
# CHECADOR_VINCULACION_WINDOW_MIN=15      # ventana del límite de códigos inválidos
# CHECADOR_DISPOSITIVO_WINDOW_MIN=5       # ventana del límite de fallos por dispositivo
# ALMACEN_DIR=                            # carpeta de archivos (default back/almacen)
